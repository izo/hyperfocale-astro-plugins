{
  "name": "@regrets/hyperfocale",
  "version": "0.25.1",
  "type": "module",
  "description": "Plugin Astro pour sites de photographie — gestion de séries photo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/izo/hyperfocale-astro-plugins.git"
  },
  "homepage": "https://github.com/izo/hyperfocale-astro-plugins#readme",
  "bugs": {
    "url": "https://github.com/izo/hyperfocale-astro-plugins/issues"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "photography",
    "gallery",
    "series",
    "lightbox"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/SeriesCard.astro": "./dist/components/SeriesCard.astro",
    "./components/SeriesList.astro": "./dist/components/SeriesList.astro",
    "./components/SeriesGallery.astro": "./dist/components/SeriesGallery.astro",
    "./components/SeriesLightbox.astro": "./dist/components/SeriesLightbox.astro",
    "./components/SeriesAttachments.astro": "./dist/components/SeriesAttachments.astro",
    "./components/SeriesEmbeds.astro": "./dist/components/SeriesEmbeds.astro",
    "./components/SeriesFilter.astro": "./dist/components/SeriesFilter.astro",
    "./components/SeriesMap.astro": "./dist/components/SeriesMap.astro",
    "./components/SeriesMasonry.astro": "./dist/components/SeriesMasonry.astro",
    "./components/SeriesPagination.astro": "./dist/components/SeriesPagination.astro",
    "./components/SeriesLineup.astro": "./dist/components/SeriesLineup.astro",
    "./styles/attachments.css": "./dist/theme/attachments.css",
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "import": "./dist/helpers/index.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    },
    "./ingest": {
      "types": "./dist/ingest/index.d.ts",
      "import": "./dist/ingest/index.js"
    },
    "./ingest/fs": {
      "types": "./dist/ingest/fs.d.ts",
      "import": "./dist/ingest/fs.js"
    },
    "./ingest/dropbox": {
      "types": "./dist/ingest/dropbox.d.ts",
      "import": "./dist/ingest/dropbox.js"
    },
    "./ingest/webdav": {
      "types": "./dist/ingest/webdav.d.ts",
      "import": "./dist/ingest/webdav.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "bin": {
    "hyperfocale": "dist/cli/init.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run tests/unit && npm run test:components",
    "test:components": "vitest run -c vitest.components.config.ts",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "fixtures:sync": "node scripts/sync-spec-fixtures.mjs",
    "fixtures:check": "node scripts/sync-spec-fixtures.mjs --check",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test:unit",
    "pack:dry": "npm pack --dry-run"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "astro": "^7.0.0",
    "happy-dom": "^21.0.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "js-yaml": "^5.0.0"
  }
}
