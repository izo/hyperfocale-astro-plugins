{
  "name": "hyperfocale",
  "version": "0.1.0",
  "type": "module",
  "description": "Plugin Astro 6 pour sites de photographie — gestion de séries photo",
  "license": "UNLICENSED",
  "private": true,
  "keywords": [
    "astro",
    "astro-integration",
    "photography",
    "gallery",
    "series",
    "lightbox"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "import": "./dist/helpers/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "bin": {
    "hyperfocale": "./dist/cli/init.js"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build && npm run test:unit",
    "pack:dry": "npm pack --dry-run"
  },
  "peerDependencies": {
    "astro": "^6.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "astro": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0",
    "zod": "^3.23.0"
  }
}
