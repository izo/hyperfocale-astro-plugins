{
  "name": "@izo/hyperfocale",
  "version": "0.7.0",
  "type": "module",
  "description": "Plugin Astro pour sites de photographie — gestion de séries photo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/izo/hyperfocale-astro-plugins.git"
  },
  "homepage": "https://github.com/izo/hyperfocale-astro-plugins#readme",
  "bugs": {
    "url": "https://github.com/izo/hyperfocale-astro-plugins/issues"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "photography",
    "gallery",
    "series",
    "lightbox"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/SeriesCard.astro": "./dist/components/SeriesCard.astro",
    "./components/SeriesList.astro": "./dist/components/SeriesList.astro",
    "./components/SeriesGallery.astro": "./dist/components/SeriesGallery.astro",
    "./components/SeriesLightbox.astro": "./dist/components/SeriesLightbox.astro",
    "./components/SeriesAttachments.astro": "./dist/components/SeriesAttachments.astro",
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "import": "./dist/helpers/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "bin": {
    "hyperfocale": "dist/cli/init.js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test:unit",
    "pack:dry": "npm pack --dry-run"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "esbuild": ">=0.25.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "astro": "^7.0.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.0",
    "vitest": "^4.0.0",
    "zod": "^4.3.6"
  }
}
