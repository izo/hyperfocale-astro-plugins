---
import SeriesCard from './SeriesCard.astro';
import type { Series } from '../helpers/index.js';
import type { ImageProvider, ResolvedImage } from '../media.js';
import { resolveLabels, passthroughAttrs, type InstanceProps, type HeadingLevel } from './runtime.js';

interface Props extends InstanceProps {
  series: Series[];
  columns?: number;
  prefix?: string;
  /** Niveau de titre des cartes, transmis à chaque `SeriesCard` (défaut : 2). */
  headingLevel?: HeadingLevel;
  /**
   * Options propres à chaque carte (variante, champs, couverture…), calculées
   * par série : c'est le point d'extension de la carte. Elles s'ajoutent aux
   * props de la liste, et l'emportent sur elles.
   */
  cardProps?: (series: Series, index: number) => Record<string, unknown>;
  /** Disposition en maçonnerie : colonnes CSS, cartes de hauteur naturelle. @default false */
  masonry?: boolean;
  /** Couvertures résolues par l'appelant, par identifiant de série (`series.id`). */
  coverImages?: Record<string, ResolvedImage>;
  /** Fournisseur d'image, transmis à chaque `SeriesCard`. */
  imageProvider?: ImageProvider;
}

const {
  series,
  columns = 3,
  prefix = '/series',
  headingLevel,
  cardProps,
  masonry = false,
  coverImages,
  imageProvider,
  locale = 'fr',
  labels: labelOverrides,
  class: className,
  ...rest
} = Astro.props;

const labels = resolveLabels(locale, labelOverrides);
const rootAttrs = passthroughAttrs(rest);
---

<section
  class:list={['hf-series-list', { 'hf-series-list--masonry': masonry }, className]}
  style={`--hf-columns: ${columns}`}
  {...rootAttrs}
>
  {series.length === 0 ? (
    <p class="hf-series-list__empty">{labels['list.empty']}</p>
  ) : (
    series.map((s, i) => (
      <SeriesCard
        series={s}
        prefix={prefix}
        headingLevel={headingLevel}
        coverImage={coverImages?.[s.id]}
        imageProvider={imageProvider}
        locale={locale}
        labels={labelOverrides}
        {...(cardProps ? cardProps(s, i) : {})}
      />
    ))
  )}
</section>

<style>
  .hf-series-list {
    display: grid;
    grid-template-columns: repeat(var(--hf-columns, 3), 1fr);
    gap: var(--hf-gallery-gap, 0.5rem);
  }

  @media (max-width: 900px) {
    .hf-series-list {
      grid-template-columns: repeat(min(var(--hf-columns, 3), 2), 1fr);
    }
  }

  @media (max-width: 600px) {
    .hf-series-list {
      grid-template-columns: 1fr;
    }
  }

  /* Maçonnerie : colonnes CSS, chaque carte garde sa hauteur. */
  .hf-series-list--masonry {
    display: block;
    columns: var(--hf-columns, 3);
    column-gap: var(--hf-gallery-gap, 0.5rem);
  }

  .hf-series-list--masonry > * {
    display: block;
    break-inside: avoid;
    margin-bottom: var(--hf-gallery-gap, 0.5rem);
  }

  @media (max-width: 900px) {
    .hf-series-list--masonry {
      columns: min(var(--hf-columns, 3), 2);
    }
  }

  @media (max-width: 600px) {
    .hf-series-list--masonry {
      columns: 1;
    }
  }

  .hf-series-list__empty {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--hf-color-text-muted);
    font-family: var(--hf-font-sans, system-ui);
    padding: 2rem;
  }
</style>
