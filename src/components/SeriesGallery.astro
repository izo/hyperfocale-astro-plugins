---
import { Image } from 'astro:assets';
import SeriesLightbox from './SeriesLightbox.astro';
import SeriesPagination from './SeriesPagination.astro';
import type { ImageMetadata } from '../helpers/index.js';
import {
  applyImageProvider,
  fallbackSrc,
  isResolvedImage,
  type ImageProvider,
  type ResolvedImage,
} from '../media.js';
import { resolveLabels, formatLabel, passthroughAttrs, type InstanceProps } from './runtime.js';

interface Props extends InstanceProps {
  /** Images de la page courante : `ImageMetadata` d'Astro, ou images résolues par l'appelant */
  images: Array<ImageMetadata | ResolvedImage>;
  /** Toutes les images de la série (pour la lightbox) */
  allImages: Array<ImageMetadata | ResolvedImage>;
  /** Numéro de page courant (1-indexed) */
  page: number;
  /** Nombre total de pages */
  totalPages: number;
  /** URL de base pour la pagination, ex: /series/bretagne-2024 */
  baseUrl: string;
  /** Fournisseur d'image appliqué aux images résolues (redimensionnement, CDN). */
  imageProvider?: ImageProvider;
  /**
   * Nombre de colonnes. Sans valeur, la grille s'adapte à la largeur (vignettes
   * d'au moins 220 px). Avec une valeur, la grille est fixe et passe à deux
   * colonnes sous 600 px.
   */
  columns?: number;
  /** Disposition en maçonnerie (colonnes CSS, hauteurs naturelles). @default false */
  masonry?: boolean;
  /** Nombre d'images chargées tout de suite (`loading="eager"`), depuis la première. @default 1 */
  eagerCount?: number;
  /** Attribut `sizes` des images, pour le choix de la source par le navigateur. */
  sizes?: string;
}

const {
  images,
  allImages,
  page,
  totalPages,
  baseUrl,
  imageProvider,
  columns,
  masonry = false,
  eagerCount = 1,
  sizes,
  locale = 'fr',
  labels: labelOverrides,
  class: className,
  ...rest
} = Astro.props;

const labels = resolveLabels(locale, labelOverrides);
const rootAttrs = { 'aria-label': labels['gallery.label'], ...passthroughAttrs(rest) };

// Disposition : 'grid' (vignettes carrées recadrées) ou 'column' (colonne pleine
// largeur, ratios naturels — ne recadre pas les diptyques ni les portraits).
const galleryLayout = (import.meta.env.HYPERFOCALE_GALLERY_LAYOUT ?? 'grid') as 'grid' | 'column';

// Traitement des images (option `imageOptimization`).
//
// `disabled` sert le fichier d'origine, sans passer par `astro:assets`.
// En `auto`, le `srcset` haute densité est omis en dev : quand le site délègue
// l'optimisation à son hébergeur (Vercel, Netlify, Cloudflare), ces endpoints
// n'existent pas localement et chaque variante du srcset répond 404.
const optimizeImages = (import.meta.env.HYPERFOCALE_IMAGE_OPTIMIZATION ?? 'auto') !== 'disabled';
const densities = import.meta.env.DEV ? undefined : [1, 2];

// Calcule l'offset d'index pour la lightbox (pour ouvrir à la bonne image globale)
// On ne connait pas pageSize ici mais on peut calculer depuis allImages et images
const pageStartIndex = allImages.findIndex(
  (img) => img.src === (images[0]?.src ?? '')
);
const safePageStartIndex = pageStartIndex >= 0 ? pageStartIndex : 0;

---

<section
  class:list={[
    'hf-gallery',
    `hf-gallery--${galleryLayout}`,
    { 'hf-gallery--masonry': masonry, 'hf-gallery--columns': columns !== undefined },
    className,
  ]}
  style={columns !== undefined ? `--hf-gallery-columns: ${columns}` : undefined}
  {...rootAttrs}
>
  <div class="hf-gallery__grid">
    {images.map((image, i) => {
      const globalIndex = safePageStartIndex + i;
      const alt = image.alt ?? formatLabel(labels['image.alt'], { n: globalIndex + 1 });
      const original = isResolvedImage(image) ? image : undefined;
      const resolved =
        original &&
        applyImageProvider(
          original,
          galleryLayout === 'column' ? { width: 1000 } : { width: 600, height: 400 },
          imageProvider,
        );
      const fallback = original && resolved ? fallbackSrc(original, resolved) : undefined;
      return (
        <button
          class="hf-gallery__item"
          type="button"
          aria-label={formatLabel(labels['gallery.open'], { n: globalIndex + 1 })}
          data-lightbox-index={globalIndex}
        >
          {resolved ? (
            <img
              src={resolved.src}
              srcset={resolved.srcset}
              sizes={resolved.sizes ?? sizes}
              alt={alt}
              width={resolved.width || undefined}
              height={resolved.height || undefined}
              data-hf-fallback={fallback}
              class="hf-gallery__img"
              loading={globalIndex < eagerCount ? 'eager' : 'lazy'}
              decoding="async"
            />
          ) : !optimizeImages ? (
            <img
              src={image.src}
              alt={alt}
              width={image.width || undefined}
              height={image.height || undefined}
              sizes={sizes}
              class="hf-gallery__img"
              loading={globalIndex < eagerCount ? 'eager' : 'lazy'}
              decoding="async"
            />
          ) : galleryLayout === 'column' ? (
            <Image
              src={image as Parameters<typeof Image>[0]['src']}
              alt={alt}
              width={1000}
              densities={densities}
              sizes={sizes}
              class="hf-gallery__img"
              loading={globalIndex < eagerCount ? 'eager' : 'lazy'}
            />
          ) : (
            <Image
              src={image as Parameters<typeof Image>[0]['src']}
              alt={alt}
              width={600}
              height={400}
              sizes={sizes}
              class="hf-gallery__img"
              loading="lazy"
            />
          )}
        </button>
      );
    })}
  </div>

  <SeriesPagination page={page} totalPages={totalPages} baseUrl={baseUrl} locale={locale} labels={labelOverrides} />
</section>

<SeriesLightbox images={allImages} locale={locale} labels={labelOverrides} />

<script>
  import './image-fallback.js';

  // Délégation d'événements sur les boutons de la galerie
  document.querySelectorAll<HTMLButtonElement>('.hf-gallery__item').forEach((btn) => {
    btn.addEventListener('click', () => {
      const index = parseInt(btn.dataset['lightboxIndex'] ?? '0', 10);
      const lb = (window as typeof window & { hfLightbox?: { open: (i: number) => void } }).hfLightbox;
      lb?.open(index);
    });
  });
</script>

<style>
  .hf-gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--hf-gallery-gap, 0.5rem);
  }

  .hf-gallery__item {
    display: block;
    cursor: pointer;
    padding: 0;
    border: none;
    background: var(--hf-color-border);
    border-radius: var(--hf-card-radius, 4px);
    overflow: hidden;
    aspect-ratio: 1;
    transition: opacity var(--hf-transition, 200ms ease);
  }

  .hf-gallery__item:hover,
  .hf-gallery__item:focus-visible {
    opacity: 0.85;
    outline: 2px solid var(--hf-color-accent);
    outline-offset: 2px;
  }

  .hf-gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ─── Mode colonne : pleine largeur, ratios naturels ────────────────────
     Une seule colonne, images non recadrées (préserve diptyques et portraits). */
  .hf-gallery--column .hf-gallery__grid {
    grid-template-columns: 1fr;
    gap: var(--hf-gallery-gap, 3.5rem);
  }

  .hf-gallery--column .hf-gallery__item {
    aspect-ratio: auto;
    background: transparent;
    border-radius: 0;
  }

  .hf-gallery--column .hf-gallery__img {
    height: auto;
    object-fit: contain;
  }

  /* ─── Colonnes fixes et maçonnerie ─────────────────────────────────── */
  .hf-gallery--columns .hf-gallery__grid {
    grid-template-columns: repeat(var(--hf-gallery-columns, 3), minmax(0, 1fr));
  }

  .hf-gallery--masonry .hf-gallery__grid {
    display: block;
    columns: var(--hf-gallery-columns, 3);
    column-gap: var(--hf-gallery-gap, 0.5rem);
  }

  .hf-gallery--masonry .hf-gallery__item {
    display: block;
    width: 100%;
    margin-bottom: var(--hf-gallery-gap, 0.5rem);
    break-inside: avoid;
    aspect-ratio: auto;
    background: transparent;
  }

  .hf-gallery--masonry .hf-gallery__img {
    height: auto;
    object-fit: contain;
  }

  @media (max-width: 600px) {
    .hf-gallery--columns .hf-gallery__grid {
      grid-template-columns: repeat(min(var(--hf-gallery-columns, 3), 2), minmax(0, 1fr));
    }

    .hf-gallery--masonry .hf-gallery__grid {
      columns: min(var(--hf-gallery-columns, 3), 2);
    }
  }

  /* ─── Pagination ────────────────────────────────────────────────────── */
  .hf-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .hf-pagination__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--hf-card-radius, 4px);
    color: var(--hf-color-text);
    text-decoration: none;
    transition: background var(--hf-transition, 200ms ease);
  }

  .hf-pagination__btn:hover,
  .hf-pagination__btn:focus-visible {
    background: var(--hf-color-surface);
    outline: 2px solid var(--hf-color-accent);
    outline-offset: 2px;
  }

  .hf-pagination__btn--disabled {
    opacity: 0.3;
    cursor: default;
    pointer-events: none;
  }

  .hf-pagination__pages {
    display: flex;
    gap: 0.25rem;
  }

  .hf-pagination__page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0 0.5rem;
    border-radius: var(--hf-card-radius, 4px);
    font-size: 0.9rem;
    font-family: var(--hf-font-sans, system-ui);
    color: var(--hf-color-text);
    text-decoration: none;
    transition: background var(--hf-transition, 200ms ease);
  }

  .hf-pagination__page:hover,
  .hf-pagination__page:focus-visible {
    background: var(--hf-color-surface);
    outline: 2px solid var(--hf-color-accent);
    outline-offset: 2px;
  }

  .hf-pagination__page--current {
    background: var(--hf-color-accent);
    color: var(--hf-color-on-accent);
    font-weight: 600;
  }
</style>
