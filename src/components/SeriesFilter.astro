---
import type { Series } from '../helpers/index.js';
import { resolveLabels, formatLabel, passthroughAttrs, scriptJson, type InstanceProps } from './runtime.js';

/** Filtres proposés : recherche, tags, année, lieu, collection, visibilité. */
type FilterName = 'search' | 'tags' | 'date' | 'location' | 'collection' | 'visibility';

interface Props extends InstanceProps {
  /** Séries rendues au serveur. Les facettes se calculent sur elles. */
  series: Series[];
  /** @default ['search', 'tags', 'date', 'location'] */
  filters?: FilterName[];
  prefix?: string;
  /**
   * Index distant (JSON, tableau de séries au format du filtre), chargé à la
   * première interaction. Une fois chargé, il remplace la liste rendue au
   * serveur : seules les séries de `series` sont dans la page.
   */
  indexUrl?: string;
}

const {
  series,
  filters = ['search', 'tags', 'date', 'location'],
  prefix = '/series',
  indexUrl,
  locale = 'fr',
  labels: labelOverrides,
  class: className,
  ...rest
} = Astro.props;

const labels = resolveLabels(locale, labelOverrides);
const rootAttrs = passthroughAttrs(rest);

const showSearch = filters.includes('search');
const showTags = filters.includes('tags');
const showDate = filters.includes('date');
const showLocation = filters.includes('location');
const showCollection = filters.includes('collection');
const showVisibility = filters.includes('visibility');

const d = (s: Series) => s.data as Record<string, unknown>;
const normalizedPrefix = prefix.endsWith('/') ? prefix.slice(0, -1) : prefix;

const allTags = [...new Set(series.flatMap((s) => (d(s).tags as string[] | undefined) ?? []))].sort();
const allYears = [...new Set(
  series
    .map((s) => (d(s).date instanceof Date ? (d(s).date as Date).getFullYear() : null))
    .filter((y): y is number => y !== null),
)].sort((a, b) => b - a);
const allCollections = [...new Set(series.map((s) => s.collection).filter((c): c is string => !!c))].sort();
const hasPrivate = series.some((s) => d(s).private === true);

type ItemData = {
  id: string;
  title: string;
  description: string | null;
  date: number | null;
  tags: string[];
  location: string | null;
  url: string;
  collection: string;
  private: boolean;
};

const items: ItemData[] = series.map((s) => ({
  id: s.id,
  title: String(s.data.title),
  description: typeof d(s).description === 'string' ? (d(s).description as string) : null,
  date: d(s).date instanceof Date ? (d(s).date as Date).getFullYear() : null,
  tags: (d(s).tags as string[] | undefined) ?? [],
  location: (d(s).location as string | undefined) ?? null,
  url: `${normalizedPrefix}/${s.id}/`,
  collection: s.collection,
  private: d(s).private === true,
}));

// Données du script client (#138) : injectées par `set:html` — dans un
// `<script>`, Astro n'évalue pas `{}` et le JSON n'était pas rendu, si bien que
// `JSON.parse` levait et que le filtre restait inerte. `scriptJson` échappe `<`
// (un titre contenant `</script>` fermerait la balise).
const filterData = scriptJson({
  locale,
  count: labels['filter.count'],
  tagList: labels['filter.tagList'],
  items,
  ...(indexUrl ? { indexUrl } : {}),
});

const showCollectionControl = showCollection && allCollections.length > 1;
const showVisibilityControl = showVisibility && hasPrivate;
const hasControls =
  showSearch ||
  (showTags && allTags.length > 0) ||
  (showDate && allYears.length > 0) ||
  showLocation ||
  showCollectionControl ||
  showVisibilityControl;
---

<div class:list={['hf-filter', className]} id="hf-filter" {...rootAttrs}>
  {hasControls && (
    <form class="hf-filter__controls" id="hf-filter-form" novalidate>
      {showSearch && (
        <div class="hf-filter__group">
          <label class="hf-filter__legend" for="hf-filter-search">{labels['filter.search']}</label>
          <input
            type="search"
            id="hf-filter-search"
            name="q"
            class="hf-filter__input"
            placeholder={labels['filter.searchPlaceholder']}
            autocomplete="off"
          />
        </div>
      )}
      {showTags && allTags.length > 0 && (
        <fieldset class="hf-filter__group">
          <legend class="hf-filter__legend">{labels['filter.tags']}</legend>
          <div class="hf-filter__tag-grid">
            {allTags.map((tag) => (
              <label class="hf-filter__tag-label">
                <input type="checkbox" name="tag" value={tag} class="hf-filter__checkbox" />
                {tag}
              </label>
            ))}
          </div>
        </fieldset>
      )}
      <div class="hf-filter__row">
        {showDate && allYears.length > 0 && (
          <div class="hf-filter__group hf-filter__group--inline">
            <label class="hf-filter__legend" for="hf-filter-year">{labels['filter.year']}</label>
            <select id="hf-filter-year" name="year" class="hf-filter__select">
              <option value="">{labels['filter.allYears']}</option>
              {allYears.map((y) => <option value={String(y)}>{y}</option>)}
            </select>
          </div>
        )}
        {showCollectionControl && (
          <div class="hf-filter__group hf-filter__group--inline">
            <label class="hf-filter__legend" for="hf-filter-collection">{labels['filter.collection']}</label>
            <select id="hf-filter-collection" name="collection" class="hf-filter__select">
              <option value="">{labels['filter.allCollections']}</option>
              {allCollections.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>
        )}
        {showVisibilityControl && (
          <div class="hf-filter__group hf-filter__group--inline">
            <label class="hf-filter__legend" for="hf-filter-visibility">{labels['filter.visibility']}</label>
            <select id="hf-filter-visibility" name="visibility" class="hf-filter__select">
              <option value="">{labels['filter.visibilityAll']}</option>
              <option value="public">{labels['filter.visibilityPublic']}</option>
              <option value="private">{labels['filter.visibilityPrivate']}</option>
            </select>
          </div>
        )}
        {showLocation && (
          <div class="hf-filter__group hf-filter__group--inline">
            <label class="hf-filter__legend" for="hf-filter-location">{labels['filter.location']}</label>
            <input
              type="search"
              id="hf-filter-location"
              name="location"
              class="hf-filter__input"
              placeholder={labels['filter.locationPlaceholder']}
              autocomplete="off"
            />
          </div>
        )}
        <button type="reset" class="hf-filter__reset">{labels['filter.reset']}</button>
      </div>
    </form>
  )}

  <p
    class="hf-filter__count"
    id="hf-filter-count"
    aria-live="polite"
    aria-atomic="true"
  ></p>

  <ul class="hf-filter__list" id="hf-filter-list" role="list">
    {items.map((item) => (
      <li
        class="hf-filter__item"
        data-id={item.id}
        data-tags={item.tags.join(',')}
        data-year={item.date ?? ''}
        data-location={(item.location ?? '').toLowerCase()}
        data-collection={item.collection}
      >
        <a href={item.url} class="hf-filter__link">
          <span class="hf-filter__title">{item.title}</span>
          {(item.date || item.location) && (
            <span class="hf-filter__meta">
              {item.date}{item.date && item.location ? ' · ' : ''}{item.location}
            </span>
          )}
          {item.tags.length > 0 && (
            <span class="hf-filter__chips" aria-label={formatLabel(labels['filter.tagList'], { tags: item.tags.join(', ') })}>
              {item.tags.map((t) => <span class="hf-filter__chip">{t}</span>)}
            </span>
          )}
        </a>
      </li>
    ))}
  </ul>
</div>

<template id="hf-filter-item">
  <li class="hf-filter__item">
    <a class="hf-filter__link">
      <span class="hf-filter__title"></span>
      <span class="hf-filter__meta"></span>
      <span class="hf-filter__chips"></span>
    </a>
  </li>
</template>

<script type="application/json" id="hf-filter-data" is:inline set:html={filterData}></script>

<script>
  // Logique testée en happy-dom : tests/components/filter-client.test.ts.
  import { initSeriesFilter } from './filter-client.js';
  initSeriesFilter();
</script>

<style>
  .hf-filter {
    font-family: var(--hf-font-sans, system-ui);
  }

  .hf-filter__controls {
    background: var(--hf-filter-bg, var(--hf-color-surface));
    border: 1px solid var(--hf-filter-border, var(--hf-color-border));
    border-radius: var(--hf-filter-radius, var(--hf-card-radius, 4px));
    padding: 1rem;
    margin-bottom: 1rem;
  }

  .hf-filter__group {
    border: none;
    padding: 0;
    margin: 0 0 0.75rem;
  }

  .hf-filter__group--inline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .hf-filter__legend {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--hf-color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
    display: block;
  }

  .hf-filter__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .hf-filter__tag-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hf-filter__tag-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--hf-color-text);
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--hf-color-border);
    border-radius: 999px;
    transition: background var(--hf-transition, 200ms ease), border-color var(--hf-transition, 200ms ease);
  }

  .hf-filter__tag-label:has(.hf-filter__checkbox:checked) {
    background: var(--hf-color-accent);
    border-color: var(--hf-color-accent);
    color: var(--hf-color-on-accent);
  }

  .hf-filter__checkbox {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .hf-filter__select,
  .hf-filter__input {
    font-size: 0.875rem;
    font-family: inherit;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--hf-color-border);
    border-radius: var(--hf-card-radius, 4px);
    background: var(--hf-color-bg);
    color: var(--hf-color-text);
  }

  .hf-filter__select:focus,
  .hf-filter__input:focus {
    outline: 2px solid var(--hf-color-accent);
    outline-offset: 2px;
  }

  .hf-filter__reset {
    font-size: 0.8rem;
    font-family: inherit;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--hf-color-border);
    border-radius: var(--hf-card-radius, 4px);
    background: transparent;
    color: var(--hf-color-text-muted);
    cursor: pointer;
    margin-left: auto;
    transition: background var(--hf-transition, 200ms ease);
  }

  .hf-filter__reset:hover {
    background: var(--hf-color-border);
  }

  .hf-filter__count {
    font-size: 0.85rem;
    color: var(--hf-color-text-muted);
    margin: 0 0 0.75rem;
    min-height: 1.2em;
  }

  .hf-filter__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hf-filter__item {
    border: 1px solid var(--hf-color-border);
    border-radius: var(--hf-card-radius, 4px);
    background: var(--hf-color-surface);
    transition: box-shadow var(--hf-transition, 200ms ease);
  }

  .hf-filter__item:hover {
    box-shadow: var(--hf-card-shadow);
  }

  .hf-filter__link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 1rem;
    text-decoration: none;
    color: inherit;
  }

  .hf-filter__title {
    font-weight: 600;
    color: var(--hf-color-text);
  }

  .hf-filter__meta {
    font-size: 0.8rem;
    color: var(--hf-color-text-muted);
  }

  .hf-filter__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .hf-filter__chip {
    font-size: 0.75rem;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: var(--hf-color-border);
    color: var(--hf-color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .hf-filter__tag-label,
    .hf-filter__reset,
    .hf-filter__item {
      transition: none;
    }
  }
</style>
