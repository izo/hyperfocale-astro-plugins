---
import { Image } from 'astro:assets';
import type { Series } from '../helpers/index.js';
import { getSeriesImages } from '../helpers/index.js';
import { applyImageProvider, fallbackSrc, type ImageProvider, type ResolvedImage } from '../media.js';
import {
  resolveLabels,
  formatLabel,
  formatDate,
  passthroughAttrs,
  headingTag,
  type InstanceProps,
  type HeadingLevel,
} from './runtime.js';

/** Champs de la carte affichés sous le titre. */
type CardField = 'date' | 'description' | 'location' | 'tags';

interface Props extends InstanceProps {
  series: Series;
  prefix?: string;
  /** Niveau du titre de la carte (défaut : 2). */
  headingLevel?: HeadingLevel;
  /**
   * Couverture résolue par l'appelant (sortie de `resolveSeriesMedia`), prioritaire
   * sur `series.data.cover`. Rendue en `<img>` simple : aucun passage par `astro:assets`.
   */
  coverImage?: ResolvedImage;
  /** Fournisseur d'image appliqué à `coverImage` (redimensionnement, CDN). */
  imageProvider?: ImageProvider;
  /**
   * Disposition. `default` : couverture au-dessus du texte. `overlay` : texte posé
   * sur la couverture. `text` : pas de couverture, texte seul.
   * @default 'default'
   */
  variant?: 'default' | 'overlay' | 'text';
  /** Champs affichés sous le titre, dans cet ordre. @default ['date', 'description'] */
  fields?: CardField[];
  /** Nombre maximal de mots-clés affichés. @default 5 */
  maxTags?: number;
  /** Chargement immédiat de la couverture (au-dessus de la ligne de flottaison). @default false */
  eager?: boolean;
  /** Attribut `sizes` de la couverture, pour le choix de la source par le navigateur. */
  sizes?: string;
  /**
   * Couverture décorative : `alt` vide. Pour une carte dont le lien nomme déjà la
   * série, sans doublon à l'annonce.
   * @default false
   */
  decorativeCover?: boolean;
  /** Attributs `data-*` / `aria-*` posés sur le lien (le suivi d'un clic, par exemple). */
  linkAttrs?: Record<string, unknown>;
  /**
   * Repli quand la série n'a ni `cover` ni `coverImage` : `'series'` sert la
   * première image de la série (spec §1.6, lue dans le corpus local) ; `'none'`
   * ne lit rien et affiche le placeholder. Un site dont le corpus vient d'un
   * bucket passe `'none'`.
   * @default 'series'
   */
  coverFallback?: 'series' | 'none';
}

const {
  series,
  prefix = '/series',
  headingLevel,
  coverImage,
  imageProvider,
  variant = 'default',
  fields = ['date', 'description'],
  maxTags = 5,
  eager = false,
  sizes,
  decorativeCover = false,
  linkAttrs,
  coverFallback = 'series',
  locale = 'fr',
  labels: labelOverrides,
  class: className,
  ...rest
} = Astro.props;
const { title, date, description, cover } = series.data;
const slug = series.id;

const labels = resolveLabels(locale, labelOverrides);
const Heading = headingTag(headingLevel, 2);
const rootAttrs = passthroughAttrs(rest);
const linkLabel = formatLabel(labels['card.link'], { title: String(title) });
const coverAlt = formatLabel(labels['card.coverAlt'], { title: String(title) });
const alt = decorativeCover ? '' : coverAlt;
const loading = eager ? 'eager' : 'lazy';

// Champs libres du frontmatter : la carte ne lit que ce qu'elle affiche.
const data = series.data as Record<string, unknown>;
const location = typeof data.location === 'string' ? data.location : undefined;
const tags = Array.isArray(data.tags) ? (data.tags as string[]) : [];
const locked = data.private === true;
const shows = (field: CardField) => fields.includes(field);

const formattedDate = date instanceof Date ? formatDate(date, locale) : undefined;

const resolvedCover = coverImage
  ? applyImageProvider(coverImage, { width: 600, height: 400 }, imageProvider)
  : undefined;
const coverOriginSrc = coverImage && resolvedCover ? fallbackSrc(coverImage, resolvedCover) : undefined;

// Cover fallback — première image si `cover` absent (spec §1.6, #MVP-004)
const fallbackImage =
  !cover && !resolvedCover && coverFallback === 'series' ? (await getSeriesImages(slug, series))[0] : undefined;

// `disabled` sert le fichier d'origine, sans passer par `astro:assets`
// (option `imageOptimization` de l'intégration).
const optimizeImages = (import.meta.env.HYPERFOCALE_IMAGE_OPTIMIZATION ?? 'auto') !== 'disabled';

const normalizedPrefix = prefix.endsWith('/') ? prefix.slice(0, -1) : prefix;
const seriesUrl = `${normalizedPrefix}/${slug}/`;
---

<article class:list={['hf-card', `hf-card--${variant}`, { 'hf-card--locked': locked }, className]} {...rootAttrs}>
  <a href={seriesUrl} class="hf-card__link" aria-label={linkLabel} {...passthroughAttrs(linkAttrs ?? {})}>
    {variant !== 'text' && (
      <div class="hf-card__cover">
        {resolvedCover ? (
          <img
            src={resolvedCover.src}
            srcset={resolvedCover.srcset}
            sizes={resolvedCover.sizes ?? sizes}
            alt={decorativeCover ? '' : (resolvedCover.alt ?? coverAlt)}
            width={600}
            height={400}
            data-hf-fallback={coverOriginSrc}
            class="hf-card__image"
            loading={loading}
            decoding="async"
          />
        ) : cover && optimizeImages ? (
          <Image
            src={cover}
            alt={alt}
            width={600}
            height={400}
            sizes={sizes}
            class="hf-card__image"
            loading={loading}
          />
        ) : cover ? (
          <img
            src={(cover as { src: string }).src}
            alt={alt}
            width={600}
            height={400}
            sizes={sizes}
            class="hf-card__image"
            loading={loading}
            decoding="async"
          />
        ) : fallbackImage ? (
          <img
            src={fallbackImage.src}
            alt={decorativeCover ? '' : (fallbackImage.alt ?? coverAlt)}
            width={600}
            height={400}
            sizes={sizes}
            class="hf-card__image"
            loading={loading}
          />
        ) : (
          <div class="hf-card__placeholder" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
          </div>
        )}
      </div>
    )}
    <div class="hf-card__body">
      {locked && <span class="hf-card__badge">{labels['card.locked']}</span>}
      <Heading class="hf-card__title">{title}</Heading>
      {shows('date') && date instanceof Date && (
        <time class="hf-card__date" datetime={date.toISOString()}>{formattedDate}</time>
      )}
      {shows('location') && location && <p class="hf-card__location">{location}</p>}
      {shows('description') && description && <p class="hf-card__description">{description}</p>}
      {shows('tags') && tags.length > 0 && (
        <ul class="hf-card__tags" aria-label={labels['card.tags']}>
          {tags.slice(0, maxTags).map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </div>
  </a>
</article>

<script>
  import { mountImageFallback } from './image-fallback.js';
  mountImageFallback();
</script>

<style>
  .hf-card {
    background: var(--hf-color-surface);
    border-radius: var(--hf-card-radius, 4px);
    overflow: hidden;
    box-shadow: var(--hf-card-shadow);
    transition: transform var(--hf-transition, 200ms ease),
                box-shadow var(--hf-transition, 200ms ease);
  }

  @media (prefers-reduced-motion: reduce) {
    .hf-card,
    .hf-card__image {
      transition: none;
    }
  }

  .hf-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--hf-card-shadow-hover);
  }

  .hf-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .hf-card__cover {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--hf-color-border);
  }

  .hf-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--hf-transition, 200ms ease);
  }

  .hf-card:hover .hf-card__image {
    transform: scale(1.03);
  }

  .hf-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--hf-color-text-muted);
  }

  .hf-card__body {
    padding: 1rem;
  }

  .hf-card__badge {
    display: inline-block;
    margin-bottom: 0.5rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--hf-color-border);
    font-size: 0.75rem;
    color: var(--hf-color-text-muted);
    font-family: var(--hf-font-sans, system-ui);
  }

  .hf-card__title {
    margin: 0 0 0.25rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--hf-color-text);
    font-family: var(--hf-font-sans, system-ui);
  }

  .hf-card__date {
    display: block;
    font-size: 0.8rem;
    color: var(--hf-color-text-muted);
    margin-bottom: 0.5rem;
    font-family: var(--hf-font-sans, system-ui);
  }

  .hf-card__location {
    margin: 0 0 0.25rem;
    font-size: 0.85rem;
    color: var(--hf-color-text-muted);
    font-family: var(--hf-font-sans, system-ui);
  }

  .hf-card__description {
    margin: 0;
    font-size: 0.9rem;
    color: var(--hf-color-text-muted);
    line-height: 1.5;
    font-family: var(--hf-font-sans, system-ui);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hf-card__tags {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .hf-card__tags li {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--hf-color-border);
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--hf-color-text-muted);
    font-family: var(--hf-font-sans, system-ui);
  }

  /* Surimpression : le texte posé sur la couverture, sur un voile. La carte
     est le bloc de positionnement, sans quoi le texte se pose sur la page. */
  .hf-card--overlay {
    position: relative;
  }

  .hf-card--overlay .hf-card__body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--hf-color-overlay);
  }

  .hf-card--overlay .hf-card__title,
  .hf-card--overlay .hf-card__date,
  .hf-card--overlay .hf-card__description,
  .hf-card--overlay .hf-card__location {
    color: var(--hf-color-text-overlay);
  }

  /* Texte seul : pas de couverture, un peu plus d'air. */
  .hf-card--text .hf-card__body {
    padding: 1.25rem;
  }
</style>
