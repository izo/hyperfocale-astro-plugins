---
import type { ImageMetadata } from '../helpers/index.js';
import type { ResolvedImage } from '../media.js';
import { resolveLabels, passthroughAttrs, scriptJson, type InstanceProps } from './runtime.js';

interface Props extends InstanceProps {
  /** Images : `ImageMetadata` d'Astro, ou images résolues par l'appelant. */
  images: Array<ImageMetadata | ResolvedImage>;
  /**
   * Boucler la navigation (image suivante après la dernière). Sans `loop`, les
   * boutons arrivés au bout passent en `aria-disabled` et ne font rien.
   * @default false
   */
  loop?: boolean;
  /**
   * Images purement décoratives : `alt` vide et pas de légende, pour toute la
   * série. Sans cela, la légende reprend le texte alternatif de l'image.
   * @default false
   */
  decorativeAlt?: boolean;
}

const {
  images,
  loop = false,
  decorativeAlt = false,
  locale = 'fr',
  labels: labelOverrides,
  class: className,
  ...rest
} = Astro.props;

const labels = resolveLabels(locale, labelOverrides);
// Les deux libellés lus par le script client voyagent en attributs : le
// compteur et l'`alt` de repli changent à chaque image.
const rootAttrs = {
  'aria-label': labels['lightbox.label'],
  'data-hf-label-counter': labels['lightbox.counter'],
  'data-hf-label-alt': labels['lightbox.imageAlt'],
  'data-hf-loop': String(loop),
  'data-hf-decorative-alt': String(decorativeAlt),
  ...passthroughAttrs(rest),
};

// Données sérialisées pour le JS client. Injectées via `set:html` : dans un
// `<script>`, Astro n'évalue pas les expressions `{}` du template — sans ça, le
// JSON serait rendu littéralement et la lightbox n'aurait aucune image.
//
// `set:html` n'échappe rien, et `JSON.stringify` ne touche ni `<` ni `/` : un
// `alt` contenant `</script>` fermerait la balise, et la suite serait du HTML
// actif. `scriptJson` remplace `<` par `<`, échappement JSON valide.
// Un `alt` n'est pas toujours écrit à la main : `images.json` (§1.5.1) est
// produit par des outils qui lisent les métadonnées des fichiers.
const lightboxData = scriptJson(
  images.map((img) => ({ src: img.src, width: img.width, height: img.height, alt: img.alt })),
);
---

<dialog class:list={['hf-lightbox', className]} id="hf-lightbox" {...rootAttrs}>
  <button
    class="hf-lightbox__close"
    id="hf-lightbox-close"
    aria-label={labels['lightbox.close']}
    type="button"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>

  <button
    class="hf-lightbox__nav hf-lightbox__nav--prev"
    id="hf-lightbox-prev"
    aria-label={labels['lightbox.prev']}
    type="button"
  >
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <polyline points="15 18 9 12 15 6"/>
    </svg>
  </button>

  <figure class="hf-lightbox__stage">
    <img
      class="hf-lightbox__img"
      id="hf-lightbox-img"
      src=""
      alt=""
      loading="eager"
    />
    <figcaption class="hf-lightbox__caption" id="hf-lightbox-caption" hidden></figcaption>
  </figure>

  <button
    class="hf-lightbox__nav hf-lightbox__nav--next"
    id="hf-lightbox-next"
    aria-label={labels['lightbox.next']}
    type="button"
  >
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <polyline points="9 18 15 12 9 6"/>
    </svg>
  </button>

  <div class="hf-lightbox__counter" id="hf-lightbox-counter" aria-live="polite" aria-atomic="true"></div>
</dialog>

<!-- Données des images sérialisées pour le JS côté client -->
<script type="application/json" id="hf-lightbox-data" is:inline set:html={lightboxData}></script>

<script>
  // Se monte à l'import et expose `window.hfLightbox` (voir lightbox-client.ts).
  import './lightbox-client.js';
</script>

<style>
  .hf-lightbox {
    padding: 0;
    border: none;
    margin: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    background: transparent;
    color: var(--hf-color-text-overlay);
  }

  .hf-lightbox::backdrop {
    background: var(--hf-color-overlay);
  }

  .hf-lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .hf-lightbox__stage {
    position: relative;
    margin: 0;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .hf-lightbox__img {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 2px;
  }

  .hf-lightbox__caption {
    margin-top: 0.5rem;
    max-width: 90vw;
    text-align: center;
    color: var(--hf-color-text-overlay-muted);
    font-size: 0.875rem;
    font-family: var(--hf-font-sans, system-ui);
  }

  .hf-lightbox__caption[hidden] {
    display: none;
  }

  .hf-lightbox__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    color: var(--hf-color-text-overlay);
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--hf-transition, 200ms ease);
  }

  .hf-lightbox__close:hover,
  .hf-lightbox__close:focus-visible {
    background: var(--hf-color-btn-overlay-hover);
    outline: 2px solid var(--hf-color-text-overlay);
    outline-offset: 2px;
  }

  .hf-lightbox__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--hf-color-text-overlay);
    cursor: pointer;
    padding: 0.75rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--hf-transition, 200ms ease);
  }

  .hf-lightbox__nav:hover,
  .hf-lightbox__nav:focus-visible {
    background: var(--hf-color-btn-overlay-hover);
    outline: 2px solid var(--hf-color-text-overlay);
    outline-offset: 2px;
  }

  .hf-lightbox__nav[aria-disabled='true'] {
    opacity: 0.3;
    cursor: default;
    pointer-events: none;
  }

  .hf-lightbox__nav--prev {
    left: 1rem;
  }

  .hf-lightbox__nav--next {
    right: 1rem;
  }

  .hf-lightbox__counter {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--hf-color-text-overlay-muted);
    font-size: 0.875rem;
    font-family: var(--hf-font-sans, system-ui);
  }
</style>
