---
import type { ImageMetadata } from '../helpers/index.js';
import {
  applyImageProvider,
  fallbackSrc,
  isResolvedImage,
  type ImageProvider,
  type ResolvedImage,
} from '../media.js';
import { resolveLabels, formatLabel, passthroughAttrs, type InstanceProps } from './runtime.js';

interface Props extends InstanceProps {
  /** Images `ImageMetadata` d'Astro, ou images résolues par l'appelant. */
  images: Array<ImageMetadata | ResolvedImage>;
  /** Nombre de colonnes (défaut 3). Surchargeable via --hf-masonry-columns. */
  columns?: number;
  /** Fournisseur d'image appliqué aux images résolues (redimensionnement, CDN). */
  imageProvider?: ImageProvider;
}

const {
  images,
  columns = 3,
  imageProvider,
  locale = 'fr',
  labels: labelOverrides,
  class: className,
  ...rest
} = Astro.props;

const labels = resolveLabels(locale, labelOverrides);
const rootAttrs = passthroughAttrs(rest);

/** Image résolue, réécrite par le fournisseur, et son repli d'origine. */
function resolveMasonry(img: ImageMetadata | ResolvedImage) {
  if (!isResolvedImage(img)) return undefined;
  const applied = applyImageProvider(img, { width: 600 }, imageProvider);
  return { applied, fallback: fallbackSrc(img, applied) };
}
---

<div class:list={['hf-masonry', className]} style={`--hf-masonry-columns: ${columns}`} {...rootAttrs}>
  {images.map((img, i) => {
    const resolved = resolveMasonry(img);
    return (
      <div class="hf-masonry__item">
        <img
          src={resolved ? resolved.applied.src : img.src}
          srcset={resolved?.applied.srcset}
          sizes={resolved?.applied.sizes}
          alt={img.alt ?? formatLabel(labels['image.alt'], { n: i + 1 })}
          width={img.width || undefined}
          height={img.height || undefined}
          data-hf-fallback={resolved?.fallback}
          loading="lazy"
          decoding="async"
          class="hf-masonry__img"
        />
      </div>
    );
  })}
</div>

<style>
  .hf-masonry {
    columns: var(--hf-masonry-columns, 3);
    column-gap: var(--hf-masonry-gap, var(--hf-gallery-gap, 0.5rem));
  }

  .hf-masonry__item {
    break-inside: avoid;
    margin-bottom: var(--hf-masonry-gap, var(--hf-gallery-gap, 0.5rem));
  }

  .hf-masonry__img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--hf-card-radius, 4px);
    opacity: 0;
    transition: opacity var(--hf-transition, 200ms ease);
  }

  .hf-masonry__img.hf-loaded {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hf-masonry__img {
      opacity: 1;
      transition: none;
    }
  }
</style>

<script>
  import { mountImageFallback } from './image-fallback.js';
  mountImageFallback();

  document.querySelectorAll<HTMLImageElement>('.hf-masonry__img').forEach((img) => {
    if (img.complete) {
      img.classList.add('hf-loaded');
    } else {
      img.addEventListener('load', () => img.classList.add('hf-loaded'), { once: true });
    }
  });
</script>
