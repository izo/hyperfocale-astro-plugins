---
import { resolveLabels, formatLabel, passthroughAttrs, paginationItems, type InstanceProps } from './runtime.js';

interface Props extends InstanceProps {
  /** Numéro de page courant (1-indexé). */
  page: number;
  /** Nombre total de pages. */
  totalPages: number;
  /** URL de base de la série, sans `/page/n/` : la page 1 est `{baseUrl}/`. */
  baseUrl: string;
}

const {
  page,
  totalPages,
  baseUrl,
  locale = 'fr',
  labels: labelOverrides,
  class: className,
  ...rest
} = Astro.props;

const labels = resolveLabels(locale, labelOverrides);
const rootAttrs = passthroughAttrs(rest);

// Normalise l'URL de base : retire le slash final
const base = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;

function pageUrl(p: number): string {
  if (p === 1) return `${base}/`;
  return `${base}/page/${p}/`; // spec §1.6 : la pagination passe sous `page/`
}

const items = paginationItems(page, totalPages);
---

{totalPages > 1 && (
  <nav class:list={['hf-pagination', className]} aria-label={labels['pagination.label']} {...rootAttrs}>
    {page > 1 ? (
      <a href={pageUrl(page - 1)} class="hf-pagination__btn" rel="prev" aria-label={labels['pagination.prev']}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </a>
    ) : (
      <span class="hf-pagination__btn hf-pagination__btn--disabled" aria-disabled="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </span>
    )}

    <div class="hf-pagination__pages">
      {items.map((item) =>
        item === 'gap' ? (
          <span class="hf-pagination__gap" aria-hidden="true">{labels['pagination.ellipsis']}</span>
        ) : item === page ? (
          <span class="hf-pagination__page hf-pagination__page--current" aria-current="page">{item}</span>
        ) : (
          <a href={pageUrl(item)} class="hf-pagination__page" aria-label={formatLabel(labels['pagination.page'], { n: item })}>{item}</a>
        ),
      )}
    </div>

    {page < totalPages ? (
      <a href={pageUrl(page + 1)} class="hf-pagination__btn" rel="next" aria-label={labels['pagination.next']}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </a>
    ) : (
      <span class="hf-pagination__btn hf-pagination__btn--disabled" aria-disabled="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </span>
    )}
  </nav>
)}

<style>
  .hf-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .hf-pagination__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--hf-card-radius, 4px);
    color: var(--hf-color-text);
    text-decoration: none;
    transition: background var(--hf-transition, 200ms ease);
  }

  .hf-pagination__btn:hover,
  .hf-pagination__btn:focus-visible {
    background: var(--hf-color-surface);
    outline: 2px solid var(--hf-color-accent);
    outline-offset: 2px;
  }

  .hf-pagination__btn--disabled {
    opacity: 0.3;
    cursor: default;
    pointer-events: none;
  }

  .hf-pagination__pages {
    display: flex;
    gap: 0.25rem;
  }

  .hf-pagination__gap {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 2.25rem;
    color: var(--hf-color-text-muted);
    font-family: var(--hf-font-sans, system-ui);
  }

  .hf-pagination__page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0 0.5rem;
    border-radius: var(--hf-card-radius, 4px);
    font-size: 0.9rem;
    font-family: var(--hf-font-sans, system-ui);
    color: var(--hf-color-text);
    text-decoration: none;
    transition: background var(--hf-transition, 200ms ease);
  }

  .hf-pagination__page:hover,
  .hf-pagination__page:focus-visible {
    background: var(--hf-color-surface);
    outline: 2px solid var(--hf-color-accent);
    outline-offset: 2px;
  }

  .hf-pagination__page--current {
    background: var(--hf-color-accent);
    color: var(--hf-color-on-accent);
    font-weight: 600;
  }
</style>
