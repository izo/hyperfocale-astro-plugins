---
import { getSeriesList } from '../helpers/index.js';
import SeriesList from '../components/SeriesList.astro';

const prefix = import.meta.env['HYPERFOCALE_PREFIX'] ?? '/series';
const series = await getSeriesList();
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Séries photo</title>
</head>
<body>
  <main>
    <h1>Séries photo</h1>
    <SeriesList series={series} prefix={prefix} />
  </main>
</body>
</html>
