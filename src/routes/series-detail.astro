---
import { render } from 'astro:content';
import Layout from 'virtual:hyperfocale/layout';
import { getSeriesList, getSeriesImages, getSeriesAttachments, getSeriesEmbeds, getSubSeries, paginateImages, seriesJsonLd } from '../helpers/index.js';
import SeriesGallery from '../components/SeriesGallery.astro';
import SeriesAttachments from '../components/SeriesAttachments.astro';
import SeriesEmbeds from '../components/SeriesEmbeds.astro';
import SeriesLineup from '../components/SeriesLineup.astro';
import { formatDate, resolveLabels } from '../i18n.js';

export async function getStaticPaths() {
  const series = await getSeriesList();
  return series.map((s) => ({
    params: { slug: s.id },
    props: { series: s },
  }));
}

const prefix = import.meta.env.HYPERFOCALE_PREFIX ?? '/series';
const pageSize = Number(import.meta.env.HYPERFOCALE_PAGE_SIZE ?? 12);

const { slug } = Astro.params;
const { series } = Astro.props;

if (!slug || !series) {
  return Astro.redirect('/404');
}

const allImages = await getSeriesImages(slug, series);
const attachments = await getSeriesAttachments(slug, series);
const embeds = await getSeriesEmbeds(slug, series);
// Line-up : vide pour une série ordinaire, peuplé pour un conteneur (spec §1.8).
const subSeries = await getSubSeries(slug);
const { items: pageImages, totalPages } = paginateImages(allImages, pageSize, 1);

const normalizedPrefix = prefix.endsWith('/') ? prefix.slice(0, -1) : prefix;
const baseUrl = `${normalizedPrefix}/${slug}`;
// Locale de la série (`lang` du frontmatter), français par défaut.
const locale = series.data.lang ?? 'fr';
const labels = resolveLabels(locale);

// Données structurées : galerie d'images de la série.
const schema = seriesJsonLd(series);

const { Content } = await render(series);
---

<Layout
  title={series.data.title}
  description={series.data.description}
  ogImage={series.data.cover}
  lang={series.data.lang}
  schema={schema}
>
  <header class="hf-series-header">
    <a href={`${normalizedPrefix}/`}>&larr; {labels['route.backToList']}</a>
    <h1>{series.data.title}</h1>
    {series.data.date && (
      <time datetime={(series.data.date as Date).toISOString()}>
        {formatDate(series.data.date as Date, locale)}
      </time>
    )}
    {series.data.location && <p class="location">{series.data.location}</p>}
  </header>

  {/* Body markdown avant la galerie */}
  <div class="hf-series-body">
    <Content />
  </div>

  <SeriesGallery
    images={pageImages}
    allImages={allImages}
    page={1}
    totalPages={totalPages}
    baseUrl={baseUrl}
  />

  {/* Contenus embarqués (spec §1.11) — avant les documents joints : ce sont
      des médias à regarder, là où les pièces jointes sont à télécharger. */}
  <SeriesEmbeds embeds={embeds} />

  {/* Documents joints après la galerie (spec §1.9) */}
  <SeriesAttachments attachments={attachments} />

  {/* Line-up des sous-séries (spec §1.8) — rien pour une série ordinaire.
      Placé en dernier : ce qui appartient à la série vient d'abord, la
      navigation vers les séries qu'elle regroupe ensuite. */}
  <SeriesLineup series={subSeries} prefix={prefix} />
</Layout>


